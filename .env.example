# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# URL of your deployed Appwrite Cloud Function
VITE_API_URL=https://6a66572c0032a728577a.fra.appwrite.run

# ── Backend ───────────────────────────────────────────────────────────────────
# Set these in Appwrite Console -> Functions -> cv-backend -> Settings ->
# Environment Variables. They are NOT read from this file at runtime.

# api.deepseek.com key — the only provider used
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Hard wall-clock budget for a single LLM round-trip, in seconds.
# MUST stay a few seconds below the function timeout set in the Appwrite
# console (and in appwrite.json). If the model is still running when this
# elapses, the function returns its own 504 *with* CORS headers instead of
# being killed by the gateway — a gateway kill returns a header-less response
# that browsers misreport as a CORS error.
#   console timeout 30s  -> LLM_DEADLINE_SECONDS=25   (default)
#   console timeout 300s -> LLM_DEADLINE_SECONDS=290
LLM_DEADLINE_SECONDS=25
